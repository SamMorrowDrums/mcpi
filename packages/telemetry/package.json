{
	"name": "@sammorrowdrums/mcpi-telemetry",
	"version": "0.84.2",
	"description": "Vendor-neutral telemetry contracts and typed schema utilities for mcpi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"telemetry",
		"tracing",
		"observability"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SamMorrowDrums/mcpi.git",
		"directory": "packages/telemetry"
	},
	"homepage": "https://github.com/SamMorrowDrums/mcpi/tree/main/packages/telemetry#readme",
	"bugs": {
		"url": "https://github.com/SamMorrowDrums/mcpi/issues"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"vitest": "4.1.9"
	}
}
