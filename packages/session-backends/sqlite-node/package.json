{
	"name": "@sammorrowdrums/mcpi-session-backend-sqlite-node",
	"version": "0.85.0",
	"description": "Node sqlite session backend for @sammorrowdrums/mcpi-agent-core sessions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
		"build": "tsgo -p tsconfig.build.json && node ./scripts/prepare-dist.mjs copy-sqlite-migrations",
		"test": "vitest --run",
		"coverage": "vitest --run --coverage",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SamMorrowDrums/mcpi.git",
		"directory": "packages/session-backends/sqlite-node"
	},
	"homepage": "https://github.com/SamMorrowDrums/mcpi/tree/main/packages/session-backends/sqlite-node#readme",
	"bugs": {
		"url": "https://github.com/SamMorrowDrums/mcpi/issues"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@sammorrowdrums/mcpi-ai": "^0.85.0",
		"@sammorrowdrums/mcpi-agent-core": "^0.85.0"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "4.1.9",
		"vitest": "4.1.9"
	}
}
