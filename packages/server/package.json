{
	"name": "@sammorrowdrums/mcpi-server",
	"version": "0.84.2",
	"description": "Experimental server package for mcpi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./unix": {
			"types": "./dist/transports/unix/index.d.ts",
			"import": "./dist/transports/unix/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"typecheck": "tsgo -p tsconfig.test.json",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"mcpi",
		"server"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SamMorrowDrums/mcpi.git",
		"directory": "packages/server"
	},
	"homepage": "https://github.com/SamMorrowDrums/mcpi/tree/main/packages/server#readme",
	"bugs": {
		"url": "https://github.com/SamMorrowDrums/mcpi/issues"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@sammorrowdrums/mcpi-ai": "^0.84.2",
		"@sammorrowdrums/mcpi-protocol": "^0.84.2"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	}
}
